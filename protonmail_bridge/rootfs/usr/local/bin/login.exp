#!/usr/bin/expect -f
# Drives the Bridge CLI. Secrets come from the environment, never argv, and
# log_user is off so nothing sensitive reaches the add-on log.
#
#   login.exp login     log in with PB_USERNAME/PB_PASSWORD/PB_2FA/PB_MAILBOX_PASSWORD, then apply security
#   login.exp settings  only apply PB_IMAP_SECURITY
#
# NOTE: prompt/response strings below are written from memory of Bridge's CLI and
# are tolerant regexes; verify them against internal/frontend/cli in v3.27.1.
set mode [lindex $argv 0]
log_user 0
set timeout 60
proc env_or_empty {name} { if {[info exists ::env($name)]} { return $::env($name) } else { return "" } }
set user  [env_or_empty PB_USERNAME]
set pass  [env_or_empty PB_PASSWORD]
set mbox  [env_or_empty PB_MAILBOX_PASSWORD]
set tfa   [env_or_empty PB_2FA]
set want  [string tolower [env_or_empty PB_IMAP_SECURITY]]

proc fail {msg} { puts "LOGIN_FAIL: $msg"; catch {send "exit\r"}; exit 1 }

spawn bash /protonmail/entrypoint.sh init
expect {
    -re {>>>\s*$} {}
    timeout { fail "Bridge CLI prompt did not appear" }
    eof     { fail "Bridge CLI exited at startup" }
}

if {$mode eq "login"} {
    send "login\r"
    set sent_2fa 0
    expect {
        -nocase -re {username[^\n]*:\s*$}          { send -- "$user\r"; exp_continue }
        -nocase -re {mailbox password[^\n]*:\s*$}  { send -- "$mbox\r"; exp_continue }
        -nocase -re {password[^\n]*:\s*$}          { send -- "$pass\r"; exp_continue }
        -nocase -re {(2fa|two[- ]factor|authentication) code[^\n]*:\s*$} {
            if {$tfa eq "" || $sent_2fa} { fail "2FA code required (empty or rejected)" }
            set sent_2fa 1
            send -- "$tfa\r"; exp_continue
        }
        -nocase -re {captcha|human verification} { fail "human verification required; use the web console" }
        -nocase -re {fido|security key}          { fail "security-key 2FA is not supported here; use the web console" }
        -nocase -re {(logged in|connected|account .* added)} {}
        -nocase -re {(invalid|incorrect|wrong|failed|error)[^\n]*} { fail "$expect_out(0,string)" }
        -re {>>>\s*$} { fail "login did not complete" }
        timeout { fail "timed out during login" }
        eof     { fail "CLI exited during login" }
    }
    puts "LOGIN_OK"
    expect -re {>>>\s*$}
}

# Apply IMAP security. The CLI command may toggle, so only run it when the current mode differs.
if {$want ne ""} {
    send "info\r"
    expect -re {>>>\s*$}
    set info $expect_out(buffer)
    if {[regexp -nocase {imap[^\n]*(ssl|starttls)} $info -> cur] && [string tolower $cur] ne $want} {
        send "change imap-security\r"
        expect {
            -nocase -re {\(y/n\)|\[y/n\]|yes/no} { send "yes\r"; exp_continue }
            -re {>>>\s*$} {}
            timeout { fail "timed out changing IMAP security" }
        }
        puts "IMAP_SECURITY_SET $want"
    }
}
send "exit\r"
expect eof
exit 0
