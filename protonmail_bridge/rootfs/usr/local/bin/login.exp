#!/usr/bin/expect -f
# Drives the Bridge CLI. Secrets come from the environment, never argv.
# CLI output after startup is recorded and only printed (secrets redacted) on failure.
#
#   login.exp login     log in with PB_USERNAME/PB_PASSWORD/PB_2FA/PB_MAILBOX_PASSWORD, then apply security
#   login.exp settings  only apply PB_IMAP_SECURITY
set mode [lindex $argv 0]
log_user 0
proc env_or_empty {name} { if {[info exists ::env($name)]} { return $::env($name) } else { return "" } }
set user  [env_or_empty PB_USERNAME]
set pass  [env_or_empty PB_PASSWORD]
set mbox  [env_or_empty PB_MAILBOX_PASSWORD]
set tfa   [env_or_empty PB_2FA]
set want  [string tolower [env_or_empty PB_IMAP_SECURITY]]
set secrets [list $pass $mbox $tfa]
set tlog /tmp/pb-cli.log
file delete -force $tlog

proc rec {} {}
proc report {} {
    global secrets tlog
    catch {log_file}
    if {[catch {set f [open $tlog r]; set s [read $f]; close $f}]} { return }
    regsub -all {\x1b\[[0-9;?]*[A-Za-z]} $s "" s
    regsub -all {[\r\x08]} $s "" s
    foreach v $secrets { if {$v ne ""} { set s [string map [list $v "***"] $s] } }
    puts "--- Bridge CLI output (secrets redacted) ---\n[string trim $s]\n---"
    file delete -force $tlog
}
proc fail {msg} { report; puts "LOGIN_FAIL: $msg"; catch {send "exit\r"}; exit 1 }

# Startup output (GPG key generation, banner) holds no secrets, so show it for diagnosis.
log_user 1
set timeout 300
set entry [expr {[info exists ::env(PB_ENTRYPOINT)] ? $::env(PB_ENTRYPOINT) : "/protonmail/entrypoint.sh"}]
spawn bash $entry init
expect {
    -re {>>>} {}
    timeout { fail "Bridge CLI prompt did not appear within 300 s" }
    eof     { fail "Bridge CLI exited at startup" }
}
log_user 0
close [open $tlog w]
file attributes $tlog -permissions 0600
log_file -a $tlog
set timeout 60

if {$mode eq "login"} {
    send "login\r"
    set sent_2fa 0
    expect {
        -nocase -re {username[^\n]*:}         { rec; send -- "$user\r"; exp_continue }
        -nocase -re {mailbox password[^\n]*:} { rec; send -- "$mbox\r"; exp_continue }
        -nocase -re {password[^\n]*:}         { rec; send -- "$pass\r"; exp_continue }
        -nocase -re {(2fa|two[- ]factor|authentication) code[^\n]*:} {
            rec
            if {$tfa eq "" || $sent_2fa} { fail "2FA code required (empty or rejected)" }
            set sent_2fa 1
            send -- "$tfa\r"; exp_continue
        }
        -nocase -re {captcha|human verification} { fail "human verification required; use the sidebar console" }
        -nocase -re {fido|security key}          { fail "security-key 2FA is not supported here; use the sidebar console" }
        -nocase -re {(added successfully|logged in|account [^\n]* added)} { rec }
        -nocase -re {(invalid|incorrect|wrong|failed|error)[^\n]*} { fail "login rejected" }
        -re {>>>\s*$} { fail "login did not complete" }
        timeout { fail "timed out during login" }
        eof     { fail "CLI exited during login" }
    }
    puts "LOGIN_OK"
    expect -re {>>>\s*$}
}

# Apply IMAP security. The CLI command may toggle, so only run it when the current mode differs.
if {$want ne ""} {
    send "info\r"
    expect -re {>>>\s*$}
    rec
    set info $expect_out(buffer)
    if {[regexp -nocase {imap[^\n]*(ssl|starttls)} $info -> cur] && [string tolower $cur] ne $want} {
        send "change imap-security\r"
        expect {
            -nocase -re {\(y/n\)|\[y/n\]|yes/no} { rec; send "yes\r"; exp_continue }
            -re {>>>\s*$} { rec }
            timeout { fail "timed out changing IMAP security" }
        }
        puts "IMAP_SECURITY_SET $want"
    }
}
send "exit\r"
expect eof
catch {log_file}
file delete -force $tlog
exit 0
